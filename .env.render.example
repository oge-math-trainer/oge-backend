DATABASE_URL=postgresql://user:password@host:5432/database
AUTH_SECRET=replace-with-at-least-32-random-characters
TOKEN_TTL=24h
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=https://your-frontend.example

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://your-backend.onrender.com/api/v1/auth/oauth/google/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=https://your-backend.onrender.com/api/v1/auth/oauth/yandex/callback
OAUTH_SUCCESS_REDIRECT_URL=https://your-frontend.example/auth/callback

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ОГЭ по математике
PASSWORD_RESET_CODE_TTL=15m

AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_API_KEY=
AITUNNEL_MODEL=
PREPARED_TASKS_MIN=50
PREPARED_TASKS_INTERVAL=5m
